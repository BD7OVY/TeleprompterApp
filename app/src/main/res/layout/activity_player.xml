<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 滚动字幕 -->
    <ScrollView
        android:id="@+id/svContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/tvContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp"
            android:textSize="32sp"
            android:textColor="#FFFFFF"
            android:lineSpacingExtra="8dp"
            android:text="" />
    </ScrollView>

    <!-- 护眼暖色滤镜层 -->
    <View
        android:id="@+id/flEyeCare"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFE8C0"
        android:alpha="0.25"
        android:visibility="gone" />

    <!-- 中央参考线（提示“当前念到这里”） -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_gravity="center_vertical"
        android:background="#80FFFFFF" />

    <!-- 顶部进度条 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#80000000"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvProgress"
            android:text="进度 0%"
            android:textColor="#FFFFFF"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="0" />
    </LinearLayout>

    <!-- 底部控制栏（横向滚动以适应小屏） -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#80000000">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <Button android:id="@+id/btnPlay" android:text="播放" />
            <Button android:id="@+id/btnRestart" android:text="重播" />
            <Button android:id="@+id/btnSpeedDown" android:text="-" />
            <TextView
                android:id="@+id/tvSpeed"
                android:text="速度 60"
                android:textColor="#FFFFFF"
                android:padding="8dp"
                android:layout_gravity="center" />
            <Button android:id="@+id/btnSpeedUp" android:text="+" />
            <Button android:id="@+id/btnFontDown" android:text="A-" />
            <Button android:id="@+id/btnFontUp" android:text="A+" />
            <Button android:id="@+id/btnColor" android:text="颜色" />
            <Button android:id="@+id/btnEyeCare" android:text="护眼" />
            <Button android:id="@+id/btnMirror" android:text="镜像" />
            <Button android:id="@+id/btnFloating" android:text="悬浮窗" />
        </LinearLayout>
    </HorizontalScrollView>
</FrameLayout>
